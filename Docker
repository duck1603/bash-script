#!/bin/bash

# Kiểm tra quyền root
if [ "$(id -u)" != "0" ]; then
   echo "Lỗi: Vui lòng chạy với quyền root."
   exit 1
fi

# Nhận diện Hệ điều hành
if [ -f /etc/os-release ]; then
    . /etc/os-release
    OS=$ID
fi

echo "Hệ điều hành phát hiện: $OS"

case "$OS" in
    ubuntu|debian)
         apt update -y
         apt install -y ca-certificates curl gnupg lsb-release

         mkdir -p /etc/apt/keyrings

         curl -fsSL https://download.docker.com/linux/$OS/gpg | gpg --dearmor -o /etc/apt/keyrings/docker.gpg
         chmod a+r /etc/apt/keyrings/docker.gpg

         echo \
         "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] \
         https://download.docker.com/linux/$OS $(lsb_release -cs) stable" \
         > /etc/apt/sources.list.d/docker.list

         apt update -y

         apt install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin

         systemctl enable --now docker
        ;;

    centos|almalinux|rocky)
        echo "Đang cài đặt cho dòng RHEL (CentOS/AlmaLinux/Rocky)..."
        yum install -y yum-utils
        yum-config-manager --add-repo https://download.docker.com/linux/centos/docker-ce.repo
        yum install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
        systemctl enable --now docker
        ;;

    *)
        echo "Lỗi: Hệ điều hành $OS chưa được hỗ trợ bởi script này."
        exit 1
        ;;
esac

# Thêm user vào docker group (nếu có SUDO_USER)
if [ -n "$SUDO_USER" ]; then
    usermod -aG docker $SUDO_USER
    echo "Đã thêm user $SUDO_USER vào nhóm docker"
else
    echo "Không xác định được user thường (SUDO_USER)"
fi

echo "-------------------------------------------------------"
echo "Cài đặt thành công trên $OS!"
docker --version
docker compose version
echo "-------------------------------------------------------"
